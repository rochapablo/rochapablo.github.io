{
  "name": "landing-page",
  "version": "1.0.0",
  "private": true,
  "description": "Minimal personal landing page.",
  "scripts": {
    "dev": "npx serve .",
    "sass": "sass --no-source-map src/scss/styles.scss dist/css/styles.css",
    "sass:watch": "sass --no-source-map --watch src/scss/styles.scss:dist/css/styles.css",
    "build": "npm run sass",
    "lint:size": "node src/tools/check-file-size.js",
    "lint": "npm run lint:size",
    "validate": "npm run build && npm run lint",
    "codegraph:init": "codegraph init",
    "codegraph:status": "codegraph status",
    "codegraph:sync": "codegraph sync",
    "codegraph:affected": "codegraph affected",
    "start": "npm run dev"
  },
  "devDependencies": {
    "@colbymchenry/codegraph": "^1.0.1",
    "sass": "^1.77.0"
  }
}
